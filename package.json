{
  "name": "edumetrics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EduMetrics student platform monorepo",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run build -w packages/shared && npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "npm run build -w packages/shared && vitest run --project integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build -w packages/shared && npm run build -w apps/api",
    "dev": "npm run build -w packages/shared && npm run dev -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}

# Copy to .env for local development. Never commit real secrets.
# Validated at startup by apps/api/src/config/env.ts (SRD 22.1); the API exits with a clear
# message (variable names only) if a required value is missing or invalid.

NODE_ENV=development          # development | test | production
PORT=3000
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# Frontend URL
APP_BASE_URL=http://localhost:5173
# Comma-separated CORS allow-list of exact origins (no wildcard, path or trailing slash)
CORS_ORIGINS=http://localhost:5173

# Connection strings. GET /readyz checks TCP reachability only (F-04 switches it to SELECT 1 and PING).
# These hosts are for running the API on your machine; under `docker compose` the api service
# overrides both to point at the mysql and redis containers.
DATABASE_URL=mysql://edumetrics:change-me@localhost:3306/edumetrics
REDIS_URL=redis://localhost:6379

# Prisma connection pool: max connections, and how long a query waits for a free one before failing.
DB_POOL_SIZE=10               # 1-100
DB_ACQUIRE_TIMEOUT_MS=3000    # 100-60000

# Provider selection (TD-016). "mock" is rejected when NODE_ENV=production.
NEWS_PROVIDER=none            # none | mock
AI_PROVIDER=none              # none | mock
VIDEO_SEARCH_PROVIDER=none    # none

# --- Docker Compose only (read by docker-compose.yml, not by the API) ---
# Placeholders for local development. Change them for anything beyond your own machine.
# Use URL-safe characters (letters and digits) in MYSQL_PASSWORD: the api container's
# DATABASE_URL is built from it.
# After changing a password, run `docker compose down -v` so the volumes are recreated.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=edumetrics
MYSQL_USER=edumetrics
MYSQL_PASSWORD=change-me
MINIO_ROOT_USER=edumetrics
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=edumetrics-dev

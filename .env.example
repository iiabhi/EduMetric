# Copy to .env for local development. Never commit real secrets.
# Validated at startup by apps/api/src/config/env.ts (SRD 22.1); the API exits with a clear
# message (variable names only) if a required value is missing or invalid.

NODE_ENV=development          # development | test | production
PORT=3000
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# Frontend URL
APP_BASE_URL=http://localhost:5173
# Comma-separated CORS allow-list of exact origins (no wildcard, path or trailing slash)
CORS_ORIGINS=http://localhost:5173

# Connection strings (validated as URLs only in F-01; nothing connects yet)
DATABASE_URL=mysql://edumetrics:change-me@localhost:3306/edumetrics
REDIS_URL=redis://localhost:6379

# Provider selection (TD-016). "mock" is rejected when NODE_ENV=production.
NEWS_PROVIDER=none            # none | mock
AI_PROVIDER=none              # none | mock
VIDEO_SEARCH_PROVIDER=none    # none
